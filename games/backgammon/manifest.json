{
  "id": "backgammon",
  "name": "Backgammon",
  "version": "2026.10.27.5",
  "sdk": "^0.1",
  "description": "The classic race for two: roll, move your checkers on the board, hit blots and bear off first. Matches to 1–100 points with the doubling cube and the Crawford rule, AI players at three strengths.",
  "players": [2],
  "turnModel": "sequential",
  "seatLayouts": [2],
  "edges": ["north", "south"],
  "localSeat": "south",
  "seatConstraints": null,
  "dynamicPlayers": false,
  "saveGame": false,
  "settings": [
    { "key": "matchLength", "type": "int", "min": 1, "max": 100, "step": 2, "default": 3, "label": "Points to win the match" },
    { "key": "cube", "type": "bool", "default": true, "label": "Doubling cube" },
    { "key": "turnSeconds", "type": "int", "min": 0, "max": 180, "step": 15, "default": 0, "label": "Seconds per turn (0 = no limit)" },
    { "key": "undo", "type": "enum", "values": ["all", "none"], "default": "all", "label": "Undo at the start" },
    { "key": "autoRoll", "type": "bool", "default": false, "label": "Roll for me at the start" }
  ],
  "ai": {
    "supported": true,
    "options": [
      { "key": "level", "type": "enum", "values": ["beginner", "average", "strong", "wildbg club", "wildbg expert", "wildbg master"], "default": "average", "label": "Strength" }
    ],
    "notice": "The wildbg strengths use wildbg, the neural-network backgammon engine by Carsten Wenderdel (https://github.com/carsten-wenderdel/wildbg), ported to TypeScript under its MIT licence; its trained networks are in the public domain (CC0-1.0, https://github.com/carsten-wenderdel/wildbg-training). Beginner, average and strong are this game's own AI.",
    "hostConfig": [],
    "timeoutSeconds": 20,
    "worker": true
  },
  "simulation": {
    "supported": true,
    "headless": true
  },
  "remoteBoardControl": true,
  "boardIntents": ["roll", "move", "undo", "done", "double", "take", "pass", "undoMode"],
  "skipTimers": ["next"],
  "lobbyButton": "top-right",
  "viewer": { "columns": [{ "key": "dice", "label": "Dice" }, { "key": "score", "label": "Score" }] },
  "permissions": []
}
