{
  "id": "liars-dice",
  "name": "Liar's Dice",
  "version": "2026.10.23.1",
  "sdk": "^0.1",
  "description": "Everyone rolls in secret under their phone. Bid how many dice of a face are on the table, or call the last bid a lie. Lose a die when you are wrong; the last player with dice wins.",
  "players": {
    "min": 2,
    "max": 6
  },
  "turnModel": "sequential",
  "seatLayouts": [2, 4, 6],
  "edges": ["north", "south", "east", "west"],
  "seatConstraints": null,
  "dynamicPlayers": false,
  "saveGame": false,
  "settings": [
    { "key": "startDice", "type": "int", "min": 2, "max": 6, "default": 5, "label": "Dice per player" },
    { "key": "onesWild", "type": "bool", "default": true, "label": "Ones are wild" },
    { "key": "turnSeconds", "type": "int", "min": 0, "max": 120, "step": 5, "default": 45, "label": "Seconds per turn (0 = no limit)" },
    { "key": "revealSeconds", "type": "int", "min": 2, "max": 20, "default": 6, "label": "Seconds to show the dice after a call" }
  ],
  "ai": {
    "supported": true,
    "options": [
      { "key": "style", "type": "enum", "values": ["cautious", "bold"], "default": "cautious", "label": "Play style" }
    ],
    "hostConfig": []
  },
  "simulation": {
    "supported": true,
    "headless": true
  },
  "remoteBoardControl": true,
  "viewer": { "columns": [{ "key": "round", "label": "Round" }, { "key": "bid", "label": "Bid" }] },
  "lobbyButton": "top-right",
  "permissions": []
}
