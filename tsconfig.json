{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "types": ["node"],
    // Games import the SDK by name; the table host maps it to its own copy at run time (games-service D-097).
    "paths": {
      "@game-table/sdk": ["./.games-service/packages/sdk/src/index.ts"],
      "@game-table/sdk/cards": ["./.games-service/packages/sdk/src/cards.ts"]
    }
  },
  // noEmit over games, tests and scripts: vitest strips types, so nothing else checks them (repository baseline 5b).
  "include": ["games/*/*.ts", "tests/**/*.ts", "scripts/**/*.ts", "vitest.config.ts"]
}
